# Copy to .env and fill in. .env is git-ignored.
# The role must NOT be a superuser: the server connects as it for everything.
DATABASE_URL=postgres://benesys:CHANGE_ME@localhost:5432/benesys
PORT=4747
# Where the web app is served from (Expo web dev server by default). Comma-separated.
CORS_ORIGINS=http://localhost:8081
