{
  "expo": {
    "name": "Billing App",
    "slug": "billing-app",
    "owner": "bennydeepa",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": [
      "billingapp",
      "com.benesys.billingapp"
    ],
    "userInterfaceStyle": "automatic",
    "ios": {
      "infoPlist": {
        "NSSpeechRecognitionUsageDescription": "Allow Billing App to recognise Tamil and English speech for voice billing.",
        "NSMicrophoneUsageDescription": "Allow Billing App to use the microphone so you can add bills by speaking.",
        "NSCameraUsageDescription": "Allow Billing App to use the camera so you can scan barcodes and photograph items."
      }
    },
    "android": {
      "package": "com.benesys.billingapp",
      "versionCode": 11,
      "adaptiveIcon": {
        "backgroundColor": "#D5076A",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#FFFFFF",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 160
        }
      ],
      "expo-sqlite",
      "expo-sharing",
      "expo-mail-composer",
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "Allow Billing App to use the microphone so you can add bills by speaking.",
          "speechRecognitionPermission": "Allow Billing App to recognise Tamil and English speech for voice billing.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox",
            "com.google.android.as"
          ]
        }
      ],
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow Billing App to use the camera so you can scan a barcode.",
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Allow Billing App to use your photos so you can put a picture on each item.",
          "cameraPermission": "Allow Billing App to use the camera so you can photograph an item."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "googleClientId": "592193262307-lbua5sv3cqd93rigqiiacsdarpu2g158.apps.googleusercontent.com",
      "router": {},
      "eas": {
        "projectId": "f66add12-35e2-4662-b11a-f6e84701f5f1"
      }
    }
  }
}
